@model List<TaskManagement.Application.DTOs.TaskDto>

@{
	Layout = null;
	var projectId = ViewBag.ProjectId as int? ?? 0;
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Project Tasks</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/admin-projects.css" asp-append-version="true" />
</head>
<body class="admin-projects-page">

	<div class="admin-layout">
		<main class="main-content">
			<section class="projects-container">
				<div class="projects-page-header">
					<div>
						<div class="projects-breadcrumb">
							<span>Admin</span>
							<span>/</span>
							<strong>Tasks</strong>
						</div>
						<h1>Project Tasks</h1>
						<p>Manage tasks for the selected project.</p>
					</div>

					<button type="button" id="addTaskBtn" class="add-project-btn" data-project-id="@projectId" data-bs-toggle="modal" data-bs-target="#addTaskModal">+ Add Task</button>
				</div>

				<div id="projectSummary" class="project-stat-card mt-3">
					<strong>Project ID:</strong> @projectId
				</div>

				<div id="tasksList">
					@if (Model != null && Model.Any())
					{
						<table class="table table-striped">
							<thead>
								<tr>
									<th>Title</th>
									<th>Assigned To</th>
									<th>Priority</th>
									<th>Status</th>
									<th>Start</th>
									<th>End</th>
									<th>Amount</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var t in Model)
								{
									<tr data-task-id="@t.Id" data-project-id="@t.ProjectId">
										<td>@t.Title</td>
										<td>@t.AssignedToUserId</td>
										<td>@t.Priority</td>
										<td>@t.Status</td>
										<td>@t.StartDate.ToString("dd MMM yyyy")</td>
										<td>@t.ExpectedEndDate.ToString("dd MMM yyyy")</td>
										<td>@t.Amount.ToString("F2")</td>
										<td>
											<button class="btn btn-sm btn-link task-details-btn" data-task-id="@t.Id">Details</button>
											<button class="btn btn-sm btn-link task-edit-btn" data-task-id="@t.Id">Edit</button>
											<button class="btn btn-sm btn-link text-danger task-delete-btn" data-task-id="@t.Id">Delete</button>
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
					else
					{
						<div class="empty-project-state">
							<h3>No tasks yet</h3>
							<p>Add tasks to get started.</p>
						</div>
					}
				</div>
			</section>
		</main>
	</div>

	<!-- ADD TASK MODAL -->
	<div class="modal fade" id="addTaskModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered modal-lg">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Add Task</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form id="addTaskForm" method="post" action="@Url.Action("Create","Tasks", new { area = "Admin" })">
					@Html.AntiForgeryToken()
					<input type="hidden" name="ProjectId" value="@projectId" />
					<div class="modal-body">
						<div class="mb-3">
							<label>Title</label>
							<input name="Title" class="form-control" required />
						</div>
						<div class="mb-3">
							<label>Scenario</label>
							<textarea name="Scenario" class="form-control"></textarea>
						</div>
						<div class="mb-3">
							<label>Assigned To</label>
							<select name="AssignedToUserId" id="addAssignedTo" class="form-control" required></select>
						</div>
						<div class="mb-3">
							<label>Priority</label>
							<select name="Priority" class="form-control">
								<option>Low</option>
								<option>Medium</option>
								<option>High</option>
								<option>Critical</option>
							</select>
						</div>
						<div class="mb-3">
							<label>Status</label>
							<select name="Status" class="form-control">
								<option>Pending</option>
								<option>In Progress</option>
								<option>Completed</option>
								<option>On Hold</option>
								<option>Cancelled</option>
							</select>
						</div>
						<div class="mb-3">
							<label>Start Date</label>
							<input type="date" name="StartDate" class="form-control" required />
						</div>
						<div class="mb-3">
							<label>Expected End Date</label>
							<input type="date" name="ExpectedEndDate" class="form-control" required />
						</div>
						<div class="mb-3">
							<label>Amount</label>
							<input type="number" step="0.01" name="Amount" class="form-control" required />
						</div>
						<div id="addTaskError" class="text-danger" style="display:none;"></div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
						<button type="submit" class="btn btn-primary">Save Task</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- EDIT TASK MODAL -->
	<div class="modal fade" id="editTaskModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered modal-lg">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Edit Task</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form id="editTaskForm" method="post" action="@Url.Action("Update","Tasks", new { area = "Admin" })">
					@Html.AntiForgeryToken()
					<input type="hidden" name="Id" id="editTaskId" />
					<input type="hidden" name="ProjectId" id="editProjectId" value="@projectId" />
					<div class="modal-body">
						<div class="mb-3">
							<label>Title</label>
							<input name="Title" id="editTitle" class="form-control" required />
						</div>
						<div class="mb-3">
							<label>Scenario</label>
							<textarea name="Scenario" id="editScenario" class="form-control"></textarea>
						</div>
						<div class="mb-3">
							<label>Assigned To</label>
							<select name="AssignedToUserId" id="editAssignedTo" class="form-control" required></select>
						</div>
						<div class="mb-3">
							<label>Priority</label>
							<select name="Priority" id="editPriority" class="form-control">
								<option>Low</option>
								<option>Medium</option>
								<option>High</option>
								<option>Critical</option>
							</select>
						</div>
						<div class="mb-3">
							<label>Status</label>
							<select name="Status" id="editStatus" class="form-control">
								<option>Pending</option>
								<option>In Progress</option>
								<option>Completed</option>
								<option>On Hold</option>
								<option>Cancelled</option>
							</select>
						</div>
						<div class="mb-3">
							<label>Start Date</label>
							<input type="date" name="StartDate" id="editStartDate" class="form-control" required />
						</div>
						<div class="mb-3">
							<label>Expected End Date</label>
							<input type="date" name="ExpectedEndDate" id="editExpectedEndDate" class="form-control" required />
						</div>
						<div class="mb-3">
							<label>Amount</label>
							<input type="number" step="0.01" name="Amount" id="editAmount" class="form-control" required />
						</div>
						<div id="editTaskError" class="text-danger" style="display:none;"></div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
						<button type="submit" class="btn btn-primary">Save</button>
					</div>
				</form>
			</div>
		</div>
	</div>


	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/admin-tasks.js" asp-append-version="true"></script>

</body>
</html>
